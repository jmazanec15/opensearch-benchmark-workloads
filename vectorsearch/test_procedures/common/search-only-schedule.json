{
  "name": "{{ stage  | default('') }}search-begin-cluster-settings",
  "operation": {
    "operation-type": "put-settings",
    "body": {
      "persistent": {
        "knn.cache.item.expiry.enabled": false
      }
    }
  }
},
{
    "name" : "{{ stage  | default('') }}warmup-indices",
    "operation" : {
        "operation-type": "warmup-knn-indices",
        "index": "{% if is_reindex is defined %}{{ reindex_target_index_name | default('reindex_target_index') }}{% else %}{{ target_index_name | default('target_index') }}{% endif %}"
    }
},
{
    "operation": {
        "name": "{{ stage  | default('') }}prod-queries-include-source",
        "operation-type": "vector-search",
        "index": "{% if is_reindex is defined %}{{ reindex_target_index_name | default('reindex_target_index') }}{% else %}{{ target_index_name | default('target_index') }}{% endif %}",
        "detailed-results": true,
        "k": {{ query_k  | default(100) }},
        "field" : "{{ target_field_name | default('target_field') }}",
        "data_set_format" : "{{ query_data_set_format | default('hdf5') }}",
        "data_set_path" : "{{ query_data_set_path }}",
        "data_set_corpus" : "{{ query_data_set_corpus }}",
        "neighbors_data_set_path" : "{{ neighbors_data_set_path }}",
        "neighbors_data_set_corpus" : "{{ neighbors_data_set_corpus }}",
        "neighbors_data_set_format" : "{{ neighbors_data_set_format | default('hdf5') }}",
        "num_vectors" : {{ query_count | default(-1) }},
        "id-field-name": "{{ id_field_name }}",
        "body": {{ include_vector_query_body | default ({}) | tojson }},
        "filter_body": {{ filter_body | default ({}) | tojson }},
        "filter_type": {{filter_type  | default ({}) | tojson }}
    },
    "clients": {{ search_clients | default(1)}}
},
{
    "operation": {
        "name": "{{ stage  | default('') }}prod-queries-exclude-source",
        "operation-type": "vector-search",
        "index": "{% if is_reindex is defined %}{{ reindex_target_index_name | default('reindex_target_index') }}{% else %}{{ target_index_name | default('target_index') }}{% endif %}",
        "detailed-results": true,
        "k": {{ query_k  | default(100) }},
        "field" : "{{ target_field_name | default('target_field') }}",
        "data_set_format" : "{{ query_data_set_format | default('hdf5') }}",
        "data_set_path" : "{{ query_data_set_path }}",
        "data_set_corpus" : "{{ query_data_set_corpus }}",
        "neighbors_data_set_path" : "{{ neighbors_data_set_path }}",
        "neighbors_data_set_corpus" : "{{ neighbors_data_set_corpus }}",
        "neighbors_data_set_format" : "{{ neighbors_data_set_format | default('hdf5') }}",
        "num_vectors" : {{ query_count | default(-1) }},
        "id-field-name": "{{ id_field_name }}",
        "body": {{ exclude_vector_query_body | default ({}) | tojson }},
        "filter_body": {{ filter_body | default ({}) | tojson }},
        "filter_type": {{filter_type  | default ({}) | tojson }}
    },
    "clients": {{ search_clients | default(1)}}
},
{
  "name": "{{ stage  | default('') }}search-end-cluster-settings",
  "operation": {
    "operation-type": "put-settings",
    "body": {
      "persistent": {
        "knn.cache.item.expiry.enabled": true,
        "knn.cache.item.expiry.minutes": "1m"
      }
    }
  }
}